# Fournisseur : api-football ou highlightly.
FOOTBALL_PROVIDER=highlightly
# Clé Football API directe Highlightly, sans préfixe VITE_.
HIGHLIGHTLY_API_KEY=
# Sans clé, le site utilise des données de démonstration clairement indiquées.
# Créer une clé gratuite sur https://dashboard.api-football.com/
# Ne jamais ajouter VITE_ devant cette variable : elle doit rester côté serveur.
FOOTBALL_API_KEY=
# Effectifs et profils actuels ; clé privée BALLDONTLIE, sans préfixe VITE_.
BALLDONTLIE_API_KEY=
# Année de début de la saison. Vide = saison en cours, déterminée automatiquement.
FOOTBALL_SEASON=
PORT=3001
# Budget local par jour UTC. Garder une marge sous le quota du fournisseur.
FOOTBALL_DAILY_LIMIT=90
# Réglage global privé : auto, manual ou pause. Modification côté serveur uniquement.
FOOTBALL_REFRESH_MODE=auto

APP_NAME="Ligue 1 Live"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single

APP_KEY=

# Comptes : activer seulement après configuration MySQL et migrations.
ACCOUNTS_ENABLED=false
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ligue1_live_local
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
# Adresse et transport à configurer avant une ouverture publique des comptes.
MAIL_MAILER=array
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Facultatif : instance MySQL locale privée déjà initialisée (jamais sur Alwaysdata).
LOCAL_MYSQL_DATADIR=

# Rappels : activer après migrations, vérification SMTP et configuration du planificateur.
REMINDERS_ENABLED=false
