# Fournisseur : api-football ou highlightly.
FOOTBALL_PROVIDER=highlightly
# Clé Football API directe Highlightly, sans préfixe VITE_.
HIGHLIGHTLY_API_KEY=
# Sans clé, le site utilise des données de démonstration clairement indiquées.
# Créer une clé gratuite sur https://dashboard.api-football.com/
# Ne jamais ajouter VITE_ devant cette variable : elle doit rester côté serveur.
FOOTBALL_API_KEY=
# Année de début de la saison. Vide = saison en cours, déterminée automatiquement.
FOOTBALL_SEASON=
PORT=3001
# Budget local par jour UTC. Garder une marge sous le quota du fournisseur.
FOOTBALL_DAILY_LIMIT=90
